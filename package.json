{
  "name": "dsh-wenxin",
  "version": "0.3.0",
  "description": "文心工作台 — DSH 网文创作插件：八角色（主编/故事策划/分章编剧/正文作者/文风编辑/连续性审核/读者审稿/素材调研员）分模型 AI 调用，每个编辑面可一键生成/补全，novel/ 结构化文件为数据库，创作台面板可视化",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "maoying": "bin/maoying.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7 <0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7 <0.3"
  },
  "dependencies": {},
  "files": [
    "index.mjs",
    "bin/",
    "lib/",
    "scripts/",
    "presets/",
    "skills/",
    "templates/",
    "docs/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "novel-writing",
    "web-novel",
    "orchestrator",
    "narrative-workbench",
    "role-routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LianaSen/dsh-maoying-narrative.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
